      ],
      "error": {
        "present": true,
        "category": 1,
        "span": "Many students are believing that",
        "correction": "Many students believe that",
        "explanation": "Động từ trạng thái 'believe' không dùng ở thì tiếp diễn."
      }
    },
    {
      "id": "ae_hk2_04",
