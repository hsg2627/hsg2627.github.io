      "curriculum": {
        "grammar": [
          3
        ],
        "topic": 9
      },
      "spans": [
        "Scientists predict that global temperatures",
        "will continue to rise",
        "over the next two decades."
      ],
      "error": {
        "present": false,
        "probe_category": 1,
        "explanation": "Đoạn văn dùng đúng thì Tương lai đơn 'will continue' cho dự báo tương lai."
      }
    },
    {
      "id": "ae_hk2_05",
      "type": "ai_eval",
      "kind": "error_detection",
      "ai_generated": true,
      "curriculum": {
        "grammar": [
          5
        ],
        "topic": 6
      },
      "spans": [
        "It is essential for developing countries",
        "protecting natural habitats",
        "and supporting ecotourism."
      ],
      "error": {
        "present": true,
        "category": 2,
        "span": "protecting natural habitats",
        "correction": "to protect natural habitats",
        "explanation": "Cấu trúc 'It is + adj + for O + to-infinitive' -> dùng 'to protect'."
      }
    },
    {
