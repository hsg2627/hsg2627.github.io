  "items": [
    {
      "id": "ae_hk2_01",
      "type": "ai_eval",
      "kind": "error_detection",
      "ai_generated": true,
      "curriculum": {
        "grammar": [
          3
        ],
        "topic": 5
      },
      "spans": [
        "Look at those dark storm clouds!",
        "It will rain heavily",
        "in just a few minutes."
      ],
      "error": {
        "present": true,
        "category": 1,
        "span": "It will rain heavily",
        "correction": "It is going to rain heavily",
        "explanation": "Có dấu hiệu bằng chứng ở hiện tại (mây đen) -> phải dùng 'is going to rain' thay vì 'will rain'."
      }
    },
    {
      "id": "ae_hk2_02",
      "type": "ai_eval",
      "kind": "error_detection",
      "ai_generated": true,
      "curriculum": {
        "grammar": [
          4
        ],
        "topic": 7
      },
      "spans": [
        "Yesterday at 8 PM,",
        "we discussed international projects",
        "when the internet disconnected."
      ],
      "error": {
        "present": true,
        "category": 1,
        "span": "we discussed international projects",
        "correction": "we were discussing international projects",
        "explanation": "Hành động đang diễn ra tại thời điểm xác định trong quá khứ -> dùng Quá khứ tiếp diễn (were discussing)."
      }
    },
    {
